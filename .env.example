# Get API_ID and API_HASH at https://my.telegram.org/apps
API_ID=
API_HASH=
# Create a control bot with @BotFather
BOT_TOKEN=
# One supergroup, using its -100... ID
CHAT_ID=
# Comma-separated numeric Telegram user IDs allowed to control from private messages
OWNER_IDS=
# Group admins can also control the player inside CHAT_ID
ALLOW_GROUP_ADMINS=true
DEFAULT_MODE=video
VIDEO_HEIGHT=360
VIDEO_FPS=15
FFMPEG_THREADS=1
DEFAULT_VOLUME=70
MAX_QUEUE=20
MAX_DURATION_SECONDS=7200
IDLE_SECONDS=60
EXTRACT_TIMEOUT_SECONDS=45
STATE_DIR=.state
# Optional local Netscape cookies file for YouTube. Keep private; never commit.
YOUTUBE_COOKIES_FILE=
